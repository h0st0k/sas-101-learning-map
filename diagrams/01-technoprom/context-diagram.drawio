<mxfile host="app.diagrams.net">
  <diagram name="Контекстная диаграмма Технопром">
    <mxGraphModel dx="1434" dy="830" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- Центральная система -->
        <mxCell id="system" value="АИС Технопром" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="300" width="200" height="80" as="geometry"/>
        </mxCell>
        
        <!-- Внешние сущности -->
        <mxCell id="client" value="Клиент" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="80" width="100" height="60" as="geometry"/>
        </mxCell>
        
        <mxCell id="manager" value="Менеджер" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="100" height="60" as="geometry"/>
        </mxCell>
        
        <mxCell id="supplier" value="Поставщик" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="520" width="100" height="60" as="geometry"/>
        </mxCell>
        
        <mxCell id="production" value="Производство" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="80" width="100" height="60" as="geometry"/>
        </mxCell>
        
        <mxCell id="warehouse" value="Склад" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="300" width="100" height="60" as="geometry"/>
        </mxCell>
        
        <mxCell id="accounting" value="Бухгалтерия" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="520" width="100" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Стрелки -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="client" target="system">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1_label" value="Заявка" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e1"/>
        
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="manager" target="system">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2_label" value="Оформление заказа" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e2"/>
        
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="supplier" target="system">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3_label" value="Запрос материалов" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e3"/>
        
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="system" target="production">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4_label" value="Задание" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e4"/>
        
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="system" target="warehouse">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5_label" value="Заказ на сборку" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e5"/>
        
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="system" target="accounting">
